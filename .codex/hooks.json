{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/.claude/hooks/deny_dangerous_bash.py\" --provider codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/.claude/hooks/stop_verify.py\" --provider codex",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
