{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 -B .claude/hooks/deny_dangerous_bash.py --provider cursor",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "python3 -B .claude/hooks/deny_dangerous_bash.py --provider cursor --event read",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 -B .claude/hooks/stop_verify.py --provider cursor",
        "timeout": 90,
        "loop_limit": 1
      }
    ]
  }
}
